# 이 파일을 복사해서 .env를 만들고 값을 채운다:  cp .env.example .env

# OpenAI (RAG · 임베딩 · GPT · TTS)
OPENAI_API_KEY=

# 네이버 검색 API (웹 수집)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# MariaDB
# docker compose로 실행하면 DB_URL·DB_USER는 compose 설정값이 쓰이고, DB_PASSWORD는 DB root 비밀번호가 된다
DB_URL=jdbc:mariadb://localhost:3307/chageun
DB_USER=root
DB_PASSWORD=

# JWT 비밀키 — Java 발급 / FastAPI 검증 공통 (32자 이상 무작위 문자열)
JWT_SECRET=

# 카카오맵 API
KAKAO_MAP_JS=
KAKAO_MAP_REST=

# 오피넷 유가 API
OPINET=
